# Global Monorepo Environment Variables Example
# Refer to apps/web/.env.example and apps/iot-gateway/.env.example for workspace specifics.
# DO NOT COMMIT REAL SECRETS OR WORKING PASSWORDS TO SOURCE CONTROL

APP_ENV=development
NODE_ENV=development

DEFAULT_LOCALE=id
FALLBACK_LOCALE=en

# Development MQTT Broker Configuration (Local Docker Mosquitto)
# Copy this file to .env or .env.local and populate local password secrets before running mqtt:pwfile or mqtt:test.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-dev-01
MQTT_GATEWAY_USERNAME=gateway_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_LOCAL_GATEWAY_PASSWORD
MQTT_DEV1_USERNAME=staging_esp32_001
MQTT_DEV1_PASSWORD=CHANGE_ME_LOCAL_DEV1_PASSWORD
MQTT_UNAUTH_USERNAME=unauthorized_device
MQTT_UNAUTH_PASSWORD=CHANGE_ME_LOCAL_UNAUTH_PASSWORD

# Feature Flags
ENABLE_FAUCET_CONTROL=false
