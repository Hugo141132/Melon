# Global Monorepo Environment Variables Example
# Refer to apps/web/.env.example and apps/iot-gateway/.env.example for workspace specifics.
# DO NOT COMMIT REAL SECRETS OR WORKING PASSWORDS TO SOURCE CONTROL

APP_ENV=development
NODE_ENV=development

DEFAULT_LOCALE=id
FALLBACK_LOCALE=en

# MQTT Broker Configuration
# Primary: EMQX Cloud (WebSocket over TLS: wss://...:8084/mqtt or TCP TLS: mqtts://...:8883)
# Local Mosquitto Fallback (Optional): mqtt://localhost:1883
# Copy this file to .env or .env.local and populate local password secrets before starting gateway.
MQTT_BROKER_URL=wss://CHANGE_ME_EMQX_HOST.emqxsl.com:8084/mqtt
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-dev-local-01
MQTT_GATEWAY_USERNAME=gateway_dev_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_EMQX_GATEWAY_PASSWORD
MQTT_DEV1_USERNAME=device_esp32_001
MQTT_DEV1_PASSWORD=CHANGE_ME_EMQX_DEV1_PASSWORD

# Optional Test-Only Fixture (Negative Authorization / Docker Mosquitto Fallback)
MQTT_UNAUTH_USERNAME=unauthorized_device
MQTT_UNAUTH_PASSWORD=CHANGE_ME_EMQX_UNAUTH_PASSWORD

# Feature Flags
ENABLE_FAUCET_CONTROL=false

# Soil & Water Quality Telemetry Adapter (Unified EMQX Broker / TASK-0412)
# Telemetry ingestion shares the primary gateway MQTT connection above.
# Hardware identity is resolved dynamically from MQTT client ID via database device registry (devices.client_id):
#   melon-esp32-tanah1 -> SOIL_NODE
#   melon-esp32-air1   -> WATER_QUALITY_NODE
SOIL_WATER_ADAPTER_ENABLED=true
SOIL_MQTT_PUB_TOPIC=melon/sensor-tanah/data-2424600050
SOIL_MQTT_SUB_TOPIC=melon/ai-tanah/rekomendasi-2424600050
WATER_MQTT_PUB_TOPIC=melon/sensor-air/data-2424600050
WATER_MQTT_SUB_TOPIC=melon/ai-air/rekomendasi-2424600050

# ESP32 Hardware Device MQTT Credentials (TASK-0412 / Device Identity Separation)
SOIL_DEVICE_MQTT_CLIENT_ID=melon-esp32-tanah1
SOIL_DEVICE_MQTT_USERNAME=petanimelon
SOIL_DEVICE_MQTT_PASSWORD=CHANGE_ME_SOIL_DEVICE_PASSWORD

WATER_DEVICE_MQTT_CLIENT_ID=melon-esp32-air1
WATER_DEVICE_MQTT_USERNAME=petanimelon
WATER_DEVICE_MQTT_PASSWORD=CHANGE_ME_WATER_DEVICE_PASSWORD

