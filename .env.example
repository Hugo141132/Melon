# Global Monorepo Environment Variables Example
# Refer to apps/web/.env.example and apps/iot-gateway/.env.example for workspace specifics.
# DO NOT COMMIT REAL SECRETS OR WORKING PASSWORDS TO SOURCE CONTROL

APP_ENV=development
NODE_ENV=development

DEFAULT_LOCALE=id
FALLBACK_LOCALE=en

# MQTT Broker Configuration
# Primary: EMQX Cloud (TLS over TCP: mqtts://...:8883 or WebSocket: wss://...:8084/mqtt)
# Local Mosquitto Fallback (Optional): mqtt://localhost:1883
# Copy this file to .env or .env.local and populate local password secrets before starting gateway.
MQTT_BROKER_URL=mqtts://CHANGE_ME_EMQX_HOST.emqxsl.com:8883
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-dev-local-01
MQTT_GATEWAY_USERNAME=gateway_dev_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_EMQX_GATEWAY_PASSWORD
MQTT_DEV1_USERNAME=device_esp32_001
MQTT_DEV1_PASSWORD=CHANGE_ME_EMQX_DEV1_PASSWORD

# Optional Test-Only Fixture (Negative Authorization / Docker Mosquitto Fallback)
MQTT_UNAUTH_USERNAME=unauthorized_device
MQTT_UNAUTH_PASSWORD=CHANGE_ME_EMQX_UNAUTH_PASSWORD

# Feature Flags
ENABLE_FAUCET_CONTROL=false
