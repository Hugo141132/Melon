# =============================================================================
# Kebun Melon — Staging Environment Configuration Template (.env.staging.example)
# =============================================================================
# Instructions:
# 1. Copy this file to .env.staging: cp .env.staging.example .env.staging
# 2. Populate placeholders with genuine staging credentials.
# 3. DO NOT COMMIT .env.staging OR REAL CREDENTIALS TO GIT.
# 4. Mandatory Safety: ENABLE_FAUCET_CONTROL must remain false.
# =============================================================================

# Application & Environment
APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info

# Localization
DEFAULT_LOCALE=id
FALLBACK_LOCALE=en
NEXT_PUBLIC_DEFAULT_LOCALE=id

# Staging Database (Supabase PostgreSQL via Supavisor Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.scqrbtfilmttqrutynyo:CHANGE_ME_STAGING_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Authentication & Sessions
AUTH_SECRET=CHANGE_ME_STAGING_AUTH_SECRET_MIN_32_HEX_CHARS
AUTH_RESET_TOKEN_EXPIRY_MINUTES=15

# Machine-to-Machine Internal Service Authentication
INTERNAL_SERVICE_TOKEN=CHANGE_ME_STAGING_INTERNAL_SERVICE_TOKEN_MIN_16_CHARS
INTERNAL_GATEWAY_TIMEOUT_MS=2000

# Inter-Service Network Addressing (Container DNS)
# Within docker-compose network:
INTERNAL_GATEWAY_URL=http://iot-gateway:3001
WEB_APP_URL=http://web:3000

# Public / Ingress Addressing (Staging Host)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REALTIME_TRANSPORT=sse

# Primary MQTT Broker: EMQX Cloud Staging
# TLS TCP Port 8883 or TLS WebSocket Port 8084
MQTT_BROKER_URL=mqtts://CHANGE_ME_EMQX_STAGING_HOST.emqxsl.com:8883
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-staging-01
MQTT_GATEWAY_USERNAME=gateway_staging_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_STAGING_GATEWAY_PASSWORD

# Device Identities (Dynamic / Staging Hardware)
MQTT_DEVICE_ID=water-tank-node-zi37gz
MQTT_DEV1_USERNAME=device_staging_001
MQTT_DEV1_PASSWORD=CHANGE_ME_STAGING_DEVICE_PASSWORD

# Optional Custom TLS Certificate Paths (empty for EMQX Cloud public CA)
MQTT_CA_CERT_PATH=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# Mandatory Safety Policy — Faucet Control Disabled
ENABLE_FAUCET_CONTROL=false

# Email Provider Configuration (Resend)
RESEND_API_KEY=re_CHANGE_ME_STAGING_RESEND_KEY
RESEND_FROM_EMAIL=Kebun Melon <onboarding@resend.dev>

# Automated Telemetry Data Retention Policy
RETENTION_ENABLED=true
RETENTION_RAW_DAYS=90
RETENTION_BATCH_SIZE=1000
RETENTION_INTERVAL_MS=86400000

# Rate Limiting Configurations (Staging defaults)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_APPROVAL_MAX=10
RATE_LIMIT_FAUCET_MAX=5
RATE_LIMIT_HISTORY_MAX=30
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_GATEWAY_MAX=60
RATE_LIMIT_WINDOW_MS=60000
