{
  "name": "@kebun-melon/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:format": "prisma format",
    "db:validate": "dotenv -e ../../apps/web/.env.example -- prisma validate",
    "db:generate": "dotenv -e ../../apps/web/.env.example -- prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "db:studio": "prisma studio",
    "db:test:schema": "vitest run test/schema.test.ts",
    "db:test:integration": "vitest run test/integration.test.ts",
    "db:test:seed": "vitest run test/seed.test.ts",
    "db:test:seed-owner": "vitest run test/seed-owner.test.ts",
    "db:test:password-service": "vitest run test/password-service.test.ts",
    "db:test:user-repository": "vitest run test/user-repository.test.ts",
    "db:test:admin-reg-unit": "vitest run test/admin-registration.unit.test.ts",
    "db:test:admin-reg-service": "vitest run test/admin-registration.service.test.ts",
    "db:test:admin-reg-integration": "vitest run test/admin-registration.integration.test.ts",
    "db:test:admin-reg-integration:docker": "tsx scripts/run-docker-integration-test.ts",
    "db:test:session-unit": "vitest run test/session-service.test.ts",
    "db:test:session-integration": "vitest run test/session-service.integration.test.ts",
    "db:test:session-integration:docker": "tsx scripts/run-session-docker-integration-test.ts",
    "db:test:approvals-integration": "vitest run test/approvals.service.integration.test.ts",
    "db:test:approvals-integration:docker": "tsx scripts/run-approvals-docker-integration-test.ts",
    "db:test:smoke-task0206": "tsx scripts/smoke-test-task0206.ts",
    "db:test:smoke-task0204": "tsx scripts/smoke-test-task0204.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "@kebun-melon/contracts": "*"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "vitest": "^1.6.0"
  }
}
