{
  "name": "kebun-melon-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "fast-uri": "3.1.5",
    "postcss": "^8.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "6.4.3",
    "@vitejs/plugin-react": "4.4.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:gateway": "npm run dev --workspace=apps/iot-gateway",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:gateway": "npm run build --workspace=packages/contracts && npm run build --workspace=packages/database && npm run build --workspace=apps/iot-gateway",
    "start:web": "npm run start --workspace=apps/web",
    "start:gateway": "npm run start --workspace=apps/iot-gateway",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "npm run db:format --workspace=packages/database",
    "db:validate": "npm run db:validate --workspace=packages/database",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=packages/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database",
    "seed:owner": "npm run seed:owner --workspace=packages/database",
    "db:studio": "npm run db:studio --workspace=packages/database",
    "db:test:schema": "npm run db:test:schema --workspace=packages/database",
    "db:test:integration": "npm run db:test:integration --workspace=packages/database",
    "db:test:seed": "npm run db:test:seed --workspace=packages/database",
    "db:test:seed-owner": "npm run db:test:seed-owner --workspace=packages/database",
    "db:test:user-repository": "npm run db:test:user-repository --workspace=packages/database",
    "env:check": "tsx scripts/check-env.ts all",
    "env:check:web": "tsx scripts/check-env.ts web",
    "env:check:gateway": "tsx scripts/check-env.ts gateway",
    "env:test": "tsx scripts/test-env.ts",
    "mqtt:pwfile": "tsx scripts/generate-mqtt-pwfile.ts",
    "sim:esp32-001": "tsx scripts/esp32-simulator.ts",
    "sim:device": "tsx scripts/device-simulator.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "scan:deps": "tsx scripts/check-dependencies.ts",
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run",
    "test:workspace": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run",
    "test:watch": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs",
    "test:coverage": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run --coverage",
    "test:integration": "npm run db:test:integration",
    "test:e2e": "playwright test",
    "check:quality": "npm run typecheck && npm run lint && npm run format:check && npm run scan:secrets && npm run scan:deps && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@node-rs/argon2-linux-x64-gnu": "2.0.2",
    "@node-rs/argon2-linux-x64-musl": "2.0.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  }
}
