# =============================================================================
# Kebun Melon — Production Environment Configuration Template (.env.production.example)
# =============================================================================
# Instructions:
# 1. Copy this file to .env.production on the VPS host: cp .env.production.example .env.production
# 2. Restrict file permissions: chmod 600 .env.production
# 3. Populate placeholders with genuine production credentials.
# 4. DO NOT COMMIT .env.production OR REAL SECRETS TO SOURCE CONTROL.
# =============================================================================

# Application & Environment
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# Localization
DEFAULT_LOCALE=id
FALLBACK_LOCALE=en
NEXT_PUBLIC_DEFAULT_LOCALE=id

# Production Database (Supabase PostgreSQL via Supavisor Pooler - Singapore ap-southeast-1)
# Runtime Format (Transaction Pooler port 6543): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.CHANGE_ME_PROD_PROJECT_REF:CHANGE_ME_PROD_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migration Format (Session Pooler port 5432 or direct): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.CHANGE_ME_PROD_PROJECT_REF:CHANGE_ME_PROD_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Authentication & Sessions (Minimum 32 hex/random characters)
AUTH_SECRET=CHANGE_ME_PRODUCTION_AUTH_SECRET_MIN_32_CHARS
AUTH_RESET_TOKEN_EXPIRY_MINUTES=1
AUTH_VERIFY_TOKEN_EXPIRY_MINUTES=1

# Machine-to-Machine Internal Service Authentication (Minimum 16 characters)
INTERNAL_SERVICE_TOKEN=CHANGE_ME_PROD_INTERNAL_SERVICE_TOKEN_MIN_16_CHARS
INTERNAL_GATEWAY_TIMEOUT_MS=3000

# Inter-Service Network Addressing (Internal Container DNS inside melon-internal-network)
INTERNAL_GATEWAY_URL=http://iot-gateway:3001
WEB_APP_URL=http://web:3000

# Public Ingress Addressing (VPS Domain)
DOMAIN=monitoring.melonmadura.my.id
ACME_EMAIL=noreply@melonmadura.my.id
APP_URL=https://monitoring.melonmadura.my.id
NEXT_PUBLIC_APP_URL=https://monitoring.melonmadura.my.id
REALTIME_TRANSPORT=sse

# Primary MQTT Broker: EMQX Cloud Production (over TLS)
# WebSocket over TLS Port 8084 or TCP TLS Port 8883
MQTT_BROKER_URL=wss://CHANGE_ME_EMQX_PROD_HOST.emqxsl.com:8084/mqtt
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-prod-01
MQTT_GATEWAY_USERNAME=gateway_prod_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_PROD_GATEWAY_PASSWORD

# Soil & Water Quality Telemetry Adapter (Unified EMQX Broker / TASK-0412)
SOIL_WATER_ADAPTER_ENABLED=true
SOIL_MQTT_PUB_TOPIC=melon/sensor-tanah/data-2424600050
SOIL_MQTT_SUB_TOPIC=melon/ai-tanah/rekomendasi-2424600050
WATER_MQTT_PUB_TOPIC=melon/sensor-air/data-2424600050
WATER_MQTT_SUB_TOPIC=melon/ai-air/rekomendasi-2424600050

# Hardware Device Credentials (EMQX Cloud Reference)
SOIL_DEVICE_MQTT_CLIENT_ID=melon-esp32-tanah1
SOIL_DEVICE_MQTT_USERNAME=petanimelon
SOIL_DEVICE_MQTT_PASSWORD=CHANGE_ME_SOIL_DEVICE_PASSWORD

WATER_DEVICE_MQTT_CLIENT_ID=melon-esp32-air1
WATER_DEVICE_MQTT_USERNAME=petanimelon
WATER_DEVICE_MQTT_PASSWORD=CHANGE_ME_WATER_DEVICE_PASSWORD

# Valve / Faucet Control Policy — Permanently Enabled (DEC-CTRL-096)
ENABLE_FAUCET_CONTROL=true

# External ML Supabase Configuration (TASK-0413 / DEC-MON-090)
# Read-only REST access to external prediction tables (soil_predictions, water_predictions).
# Server-side only; never expose to frontend or public clients.
EXTERNAL_ML_SUPABASE_URL=https://styjuynxuykvujnnqxos.supabase.co
EXTERNAL_ML_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_EXTERNAL_ML_ANON_KEY
EXTERNAL_ML_SUPABASE_SECRET_KEY=CHANGE_ME_EXTERNAL_ML_SERVICE_ROLE_KEY

# Transactional Email Provider (Resend)
RESEND_API_KEY=re_CHANGE_ME_PROD_RESEND_KEY
RESEND_FROM_EMAIL=Melon Madura <noreply@melonmadura.my.id>

# Automated Telemetry Data Retention Policy
RETENTION_ENABLED=true
RETENTION_RAW_DAYS=90
RETENTION_BATCH_SIZE=1000
RETENTION_INTERVAL_MS=86400000

# Rate Limiting Configurations (Production defaults)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_APPROVAL_MAX=10
RATE_LIMIT_FAUCET_MAX=5
RATE_LIMIT_HISTORY_MAX=30
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_GATEWAY_MAX=60
RATE_LIMIT_WINDOW_MS=60000
