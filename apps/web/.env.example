# Web Application Environment Variables Example
APP_ENV=development
NODE_ENV=development

# Web Server-Only Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/kebun_melon
AUTH_SECRET=development_secret_key_at_least_32_chars_long
DEFAULT_LOCALE=id
FALLBACK_LOCALE=en
REALTIME_TRANSPORT=sse
INTERNAL_GATEWAY_URL=http://127.0.0.1:3001
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN_AT_LEAST_16_CHARS
INTERNAL_GATEWAY_TIMEOUT_MS=2000

# Feature Flags (Default false)
ENABLE_FAUCET_CONTROL=false

# Web Client-Safe Configuration (Browser Accessible)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=id
