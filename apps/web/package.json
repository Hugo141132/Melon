{
  "name": "@kebun-melon/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:soil-telemetry-route": "vitest run app/api/v1/devices/[deviceId]/telemetry/soil/test/route.test.ts",
    "test:register-route": "vitest run app/api/v1/auth/register/test/route.test.ts",
    "test:login-route": "vitest run app/api/v1/auth/login/test/route.test.ts",
    "test:logout-route": "vitest run app/api/v1/auth/logout/test/route.test.ts",
    "test:session-route": "vitest run app/api/v1/auth/session/test/route.test.ts",
    "test:approvals-route": "vitest run app/api/v1/approvals/test/route.test.ts",
    "test:approve-route": "vitest run app/api/v1/approvals/[userId]/approve/test/route.test.ts",
    "test:approvals-page": "vitest run app/approvals/test/page.test.ts",
    "test:status-page": "vitest run app/(auth)/status/test/page.test.ts",
    "test:route-protection": "vitest run test/route_protection.test.ts",
    "test:i18n-config": "vitest run test/unit/i18n-config.test.ts"
  },
  "dependencies": {
    "@kebun-melon/contracts": "*",
    "@kebun-melon/database": "*",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "next": "^16.3.0",
    "next-intl": "^3.26.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.7",
    "resend": "^6.20.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
