# IoT Gateway Environment Variables Example
APP_ENV=development
NODE_ENV=development

# IoT Gateway Server-Only Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/kebun_melon
# Development Mosquitto: mqtt://localhost:1883 | Production: mqtts://broker.example.com:8883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-dev-01
MQTT_GATEWAY_USERNAME=gateway_user
MQTT_GATEWAY_PASSWORD=CHANGE_ME_LOCAL_GATEWAY_PASSWORD
MQTT_DEV1_USERNAME=device_esp32_001
MQTT_DEV1_PASSWORD=CHANGE_ME_LOCAL_DEV1_PASSWORD
MQTT_DEV2_USERNAME=device_node_002
MQTT_DEV2_PASSWORD=CHANGE_ME_LOCAL_DEV2_PASSWORD
MQTT_UNAUTH_USERNAME=unauthorized_device
MQTT_UNAUTH_PASSWORD=CHANGE_ME_LOCAL_UNAUTH_PASSWORD

# Optional TLS Certificate Paths
MQTT_CA_CERT_PATH=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# Feature Flags (Default false)
ENABLE_FAUCET_CONTROL=false
