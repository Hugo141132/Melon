# IoT Gateway Environment Variables Example
APP_ENV=development
NODE_ENV=development

# IoT Gateway Server-Only Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/kebun_melon
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_GATEWAY_CLIENT_ID=gateway-kebun-melon-01
MQTT_GATEWAY_USERNAME=gateway_user
MQTT_GATEWAY_PASSWORD=gateway_password

# Optional TLS Certificate Paths
MQTT_CA_CERT_PATH=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# Feature Flags (Default false)
ENABLE_FAUCET_CONTROL=false
